import os
from dataclasses import dataclass, fields
from pathlib import Path
from typing import Any


@dataclass(frozen=True, slots=True)
class Config:
    """Every setting and secret. A new setting is one field with a default.

    `from_env` reads each field from the env var of the same name in capitals
    (`app_version` from `APP_VERSION`) and casts it to the type of the default.
    """

    app_name: str = "$app_name"
    # Yard sets PROJECT_DATA_DIR=/data, a host directory that survives every deploy.
    data_dir: Path = Path("data")
    # Sign-in providers. Each one is on when its client id and secret are set.
    google_client_id: str = ""
    google_client_secret: str = ""
    github_client_id: str = ""
    github_client_secret: str = ""
    # Any other OpenID Connect issuer with discovery: Rauthy, Pocket ID, Keycloak, ...
    oidc_issuer: str = ""
    oidc_client_id: str = ""
    oidc_client_secret: str = ""
    oidc_label: str = ""
    # Emails that may sign in, comma-separated. Empty: every account of the issuer.
    login_allowed_emails: str = ""
    session_secret: str = ""
    # Plain HTTP on a laptop: the cookies drop Secure and the callback URL uses http.
    app_dev: bool = False

    @property
    def db_path(self) -> Path:
        return self.data_dir / "app.sqlite3"

    @property
    def allowed_emails(self) -> frozenset[str]:
        return frozenset(
            e.strip().lower() for e in self.login_allowed_emails.split(",") if e.strip()
        )

    @classmethod
    def from_env(cls) -> Config:
        values: dict[str, Any] = {}
        for f in fields(cls):
            raw = os.environ.get("PROJECT_DATA_DIR" if f.name == "data_dir" else f.name.upper())
            if raw is None:
                continue
            if isinstance(f.default, bool):
                values[f.name] = raw.lower() in ("1", "true", "yes")
            else:
                values[f.name] = type(f.default)(raw)
        config = cls(**values)
        if len(config.session_secret) < 32:
            raise RuntimeError("Set SESSION_SECRET to 32+ random characters.")
        pairs = {
            "GOOGLE": (config.google_client_id, config.google_client_secret),
            "GITHUB": (config.github_client_id, config.github_client_secret),
            "OIDC": (config.oidc_client_id, config.oidc_client_secret),
        }
        for name, (client_id, secret) in pairs.items():
            if bool(client_id) != bool(secret):
                raise RuntimeError(f"Set both {name}_CLIENT_ID and {name}_CLIENT_SECRET.")
        if config.oidc_client_id and not config.oidc_issuer:
            raise RuntimeError("OIDC_CLIENT_ID is set: set OIDC_ISSUER to the issuer URL.")
        if not any(client_id for client_id, _ in pairs.values()):
            raise RuntimeError("Set GOOGLE_, GITHUB_, or OIDC_CLIENT_ID and _CLIENT_SECRET.")
        config.data_dir.mkdir(parents=True, exist_ok=True)
        return config
