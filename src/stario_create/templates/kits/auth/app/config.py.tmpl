import os
from dataclasses import dataclass
from pathlib import Path


@dataclass(frozen=True, slots=True)
class Config:
    """Every setting and secret. `from_env` reads each one by its env name."""

    app_name: str = "$app_name"
    # Yard sets PROJECT_DATA_DIR=/data, a host directory that survives every deploy.
    data_dir: Path = Path("data")
    # Sign-in providers. Each one is on when its client id and secret are set.
    google_client_id: str = ""
    google_client_secret: str = ""
    github_client_id: str = ""
    github_client_secret: str = ""
    # Emails that may sign in. Empty: every account of the providers.
    allowed_emails: frozenset[str] = frozenset()
    session_secret: str = ""
    # Plain HTTP on a laptop: the cookies drop Secure and the callback URL uses http.
    app_dev: bool = False

    @property
    def db_path(self) -> Path:
        return self.data_dir / "app.sqlite3"

    @classmethod
    def from_env(cls) -> Config:
        env = os.environ
        config = cls(
            app_name=env.get("APP_NAME", "$app_name"),
            data_dir=Path(env.get("PROJECT_DATA_DIR", "data")),
            google_client_id=env.get("GOOGLE_CLIENT_ID", ""),
            google_client_secret=env.get("GOOGLE_CLIENT_SECRET", ""),
            github_client_id=env.get("GITHUB_CLIENT_ID", ""),
            github_client_secret=env.get("GITHUB_CLIENT_SECRET", ""),
            allowed_emails=frozenset(
                e.strip().lower()
                for e in env.get("LOGIN_ALLOWED_EMAILS", "").split(",")
                if e.strip()
            ),
            session_secret=env.get("SESSION_SECRET", ""),
            app_dev=env.get("APP_DEV", "") in ("1", "true", "yes"),
        )
        if len(config.session_secret) < 32:
            raise RuntimeError("Set SESSION_SECRET to 32+ random characters.")
        if bool(config.google_client_id) != bool(config.google_client_secret):
            raise RuntimeError("Set both GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET.")
        if bool(config.github_client_id) != bool(config.github_client_secret):
            raise RuntimeError("Set both GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET.")
        if not (config.google_client_id or config.github_client_id):
            raise RuntimeError("Set GOOGLE_CLIENT_ID or GITHUB_CLIENT_ID.")
        config.data_dir.mkdir(parents=True, exist_ok=True)
        return config
