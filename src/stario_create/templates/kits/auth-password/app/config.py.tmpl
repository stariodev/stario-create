import os
from dataclasses import dataclass, field
from pathlib import Path


@dataclass(frozen=True, slots=True)
class Config:
    """Every setting and secret. `from_env` reads each one by its env name."""

    app_name: str = "$app_name"
    # Yard sets PROJECT_DATA_DIR=/data, a host directory that survives every deploy.
    data_dir: Path = Path("data")
    # The only accounts: email -> password hash. `just password-hash <email>` prints one.
    accounts: dict[str, str] = field(default_factory=dict[str, str])
    session_secret: str = ""
    # Plain HTTP on a laptop: the session cookie drops Secure.
    app_dev: bool = False

    @property
    def db_path(self) -> Path:
        return self.data_dir / "app.sqlite3"

    @classmethod
    def from_env(cls) -> Config:
        env = os.environ
        # LOGIN_ACCOUNTS is "email:hash,email:hash".
        entries = (e.strip().partition(":") for e in env.get("LOGIN_ACCOUNTS", "").split(","))
        config = cls(
            app_name=env.get("APP_NAME", "$app_name"),
            data_dir=Path(env.get("PROJECT_DATA_DIR", "data")),
            accounts={
                email.strip().lower(): stored for email, _, stored in entries if email and stored
            },
            session_secret=env.get("SESSION_SECRET", ""),
            app_dev=env.get("APP_DEV", "") in ("1", "true", "yes"),
        )
        if len(config.session_secret) < 32:
            raise RuntimeError("Set SESSION_SECRET to 32+ random characters.")
        if not config.accounts:
            raise RuntimeError("Set LOGIN_ACCOUNTS: run `just password-hash you@example.com`.")
        config.data_dir.mkdir(parents=True, exist_ok=True)
        return config
