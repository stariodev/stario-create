import os
from dataclasses import dataclass, fields
from pathlib import Path
from typing import Any


@dataclass(frozen=True, slots=True)
class Config:
    """Every setting and secret. A new setting is one field with a default.

    `from_env` reads each field from the env var of the same name in capitals
    (`app_version` from `APP_VERSION`) and casts it to the type of the default.
    """

    app_name: str = "$app_name"
    # Yard sets PROJECT_DATA_DIR=/data, a host directory that survives every deploy.
    data_dir: Path = Path("data")
    # The only accounts: "email:hash,email:hash". `just password-hash <email>` prints one.
    login_accounts: str = ""
    session_secret: str = ""
    # Plain HTTP on a laptop: the session cookie drops Secure.
    app_dev: bool = False

    @property
    def db_path(self) -> Path:
        return self.data_dir / "app.sqlite3"

    @property
    def accounts(self) -> dict[str, str]:
        pairs = (entry.strip().partition(":") for entry in self.login_accounts.split(","))
        return {email.strip().lower(): stored for email, _, stored in pairs if email and stored}

    @classmethod
    def from_env(cls) -> Config:
        values: dict[str, Any] = {}
        for f in fields(cls):
            raw = os.environ.get("PROJECT_DATA_DIR" if f.name == "data_dir" else f.name.upper())
            if raw is None:
                continue
            if isinstance(f.default, bool):
                values[f.name] = raw.lower() in ("1", "true", "yes")
            else:
                values[f.name] = type(f.default)(raw)
        config = cls(**values)
        if len(config.session_secret) < 32:
            raise RuntimeError("Set SESSION_SECRET to 32+ random characters.")
        if not config.accounts:
            raise RuntimeError("Set LOGIN_ACCOUNTS: run `just password-hash you@example.com`.")
        config.data_dir.mkdir(parents=True, exist_ok=True)
        return config
