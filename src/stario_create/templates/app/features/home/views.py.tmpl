from stario import Route, h
from stario.markup import HtmlElement

from app.common.shell import page

# The home page links to each page here: one (route, label) line per page.
LINKS: tuple[tuple[Route, str], ...] = ()


def render(app_name: str) -> HtmlElement:
    return page(
        app_name,
        h.Main(
            {"id": "home"},
            h.H1(app_name),
            h.P("Stario is running. Read AGENTS.md, then add a page."),
            h.Nav(h.Ul(*[h.Li(h.A({"href": route.href()}, label)) for route, label in LINKS])),
        ),
    )
