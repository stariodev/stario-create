// Routing probes: a task the agent plans in full. `skills` must load before the plan; `ok_skills` may load without counting as waste.
{"id": "todos-live", "prompt": "Add a shared todo list at /todos. Anyone can add an item and mark it done. Every open tab shows the change right away without a reload. Keep the items in SQLite. Link /todos from the home page.", "skills": [], "ok_skills": [], "has": ["db\\.watch\\(", "read_signals\\(", "c\\.alive\\(", "patch_elements\\("], "lacks": ["pkill", "^import json", "debounce=\\d{2,}\\b"]}
{"id": "about-static", "prompt": "Add a static /about page with two paragraphs about the project, linked from the home page.", "skills": [], "not_skills": ["stario-view", "stario-relay", "stario-feature", "stario-datastar"], "has": ["w\\.html\\("], "lacks": ["\\.watch\\(", "SSE\\("]}
{"id": "accounts-password", "prompt": "People sign up with an email and a password, sign in, and sign out. Only signed-in users may post a note at /notes; everyone can read notes.", "skills": ["stario-auth"], "has": ["add auth --password"], "lacks": ["hashlib\\.sha256\\(", "bcrypt"]}
{"id": "google-signin", "prompt": "Add sign-in with Google. A signed-in user sees their name in the header; /settings is only for signed-in users.", "skills": ["stario-auth"], "has": ["stario-create(@latest)? add auth\\b(?! --password)"]}
{"id": "column-filled-db", "prompt": "The notes table already holds thousands of rows in production. Add a `pinned` flag: pinned notes list first, and a button pins or unpins a note. Existing notes start unpinned.", "skills": ["stario-litewriter"], "has": ["ALTER TABLE"], "lacks": ["DROP TABLE"]}
{"id": "sort-filter", "prompt": "Add a /products page over a products table (name, category, price). The user sorts by name or price and filters by category; a reload or a shared link keeps the same view.", "skills": ["stario-view"], "has": ["c\\.req\\.query", "href"], "lacks": ["data\\.bind\\(\"sort\""]}
{"id": "search-typing", "prompt": "Add a /search page with a text box that filters a fixed list of about 200 city names while the user types, without a reload. Show at most 20 matches and the total count.", "skills": ["stario-view"], "has": ["debounce=(\"\\d+ms\"|0\\.\\d+)"], "lacks": ["debounce=\\d{2,}\\b"]}
{"id": "poll-memory", "prompt": "Add a live poll at /poll with three options kept in memory only (no database). Each vote updates the counts in every open tab at once.", "skills": ["stario-relay"], "has": ["Relay"], "lacks": ["^[A-Za-z_]*(VOTES|votes|COUNTS|counts)\\s*(:\\s*dict|=\\s*(\\{|dict\\(|defaultdict))"]}
{"id": "edit-dialog", "prompt": "On the todos page, each item gets an Edit button that opens a dialog to rename it. The dialog must stay open, with what the user typed, while other people's changes repaint the list.", "skills": ["stario-relay|stario-datastar"], "has": ["preserve_attr\\(\"open\"\\)"], "base": "todos"}
{"id": "outside-api", "prompt": "Add a /weather page that shows the current temperature in Berlin from https://api.open-meteo.com/v1/forecast?latitude=52.52&longitude=13.41&current=temperature_2m. Cache the answer for 10 minutes, and keep the tests offline.", "skills": ["stario-outside-api|stario-api"], "has": ["httpx", "MockTransport"], "suite": false, "ok_skills": ["stario-feature"]}
{"id": "slow-report", "prompt": "Add a button that builds a CSV export of all notes. Building takes about ten seconds; the page shows live progress and then a download link.", "skills": ["stario-jobs"], "has": ["create_task"], "lacks": ["asyncio\\.create_task", "time\\.sleep"], "ok_skills": ["stario-relay"]}
{"id": "timer-loop", "prompt": "Every minute, delete notes older than 30 days. The app must still shut down cleanly.", "skills": ["stario-jobs"], "lacks": ["while True:\\s*\\n\\s*await asyncio\\.sleep", "time\\.sleep"]}
{"id": "clipboard", "prompt": "Each note gets a Copy button that copies its text to the clipboard and shows 'Copied' for two seconds.", "skills": ["stario-client"], "has": ["static/js/"]}
{"id": "tailwind", "prompt": "Style the app with Tailwind CSS and DaisyUI, with a light and a dark theme and a toggle in the header.", "skills": ["stario-tailwind-daisyui"], "has": ["add tailwind"]}
{"id": "page-tests", "prompt": "Add a /notes page where anyone adds a note and every tab updates live, and write TestClient tests: the stream sends a new note, and an empty note gets an error.", "skills": ["stario-feature"], "has": ["client\\.stream\\(", "async def test_"], "suite": false, "ok_skills": ["stario-api"]}
{"id": "navbar-count", "prompt": "The header on every page shows how many open todos there are, and the number updates live in every tab.", "skills": ["stario-feature"], "base": "todos"}
{"id": "infinite-scroll", "prompt": "The /notes list loads the next 20 notes when the user scrolls to the bottom, without a button.", "skills": ["stario-datastar|stario-view"], "has": ["on_intersect|intersect"]}
{"id": "favorite-count", "prompt": "Add articles at /articles/{id} (title, body). A signed-out-friendly Favorite button with a count; the count updates live for everyone viewing the article. Store favorites in SQLite with one row per (article, browser) using a random id kept in a cookie.", "skills": [], "ok_skills": ["stario-api", "stario-feature"], "has": ["db\\.watch\\(", "cookies"]}
{"id": "screenshot", "prompt": "After adding a /gallery page with a grid of images, make sure it renders correctly and every image loads.", "skills": ["stario-browser-check"], "lacks": ["pkill"]}
{"id": "existing-column", "prompt": "Todos get an optional due date, shown next to each item and editable when adding. The todos table already holds rows.", "base": "todos", "skills": ["stario-litewriter"], "has": ["ALTER TABLE", "app/pages/todos\\.py"], "lacks": ["DROP TABLE", "app/features/"]}
