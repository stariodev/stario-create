// Decision probes: one narrow question each; the reply is checked against the guide's answer. Run several times: an answer that changes between runs marks unclear text.
// 5.13 (was the 6.0.0.dev draft): d-page-file no longer expects `add page` (dropped from the guide), d-stop-server expects a stop by port (`kill $!` misses a job of an earlier tool call), d-taken-email also accepts the password kit's plain-form answer (422); d-env-setting accepts that the scaffold's Config already reads DATABASE_PATH.
{"id": "d-debounce", "mode": "answer", "prompt": "A search box should send its request only after the user stops typing for 300 milliseconds. Write the data.on(...) call for the input.", "has": ["debounce=(\"300ms\"|0\\.3\\b)"], "lacks": ["debounce=300\\b"]}
{"id": "d-sql-home", "mode": "answer", "prompt": "You add a comments table and the queries that list and add comments. Which file holds them, and what are the functions called?", "has": ["app/data\\.py", "schema", "list_comments", "add_comment"]}
{"id": "d-bad-input", "mode": "answer", "prompt": "A Datastar command receives an empty title. What exactly does the handler send back? Give the code.", "has": ["patch_signals\\(\\{\\s*\"_error\""], "lacks": ["status=4\\d\\d"]}
{"id": "d-missing-row", "mode": "answer", "prompt": "POST /articles/{id}/delete runs for an id with no row. What does the handler reply? Give the code.", "has": ["w\\.text\\(.*status=404"]}
{"id": "d-taken-email", "mode": "answer", "prompt": "The users table has a UNIQUE email. A sign-up uses an email that is taken. How does the handler find out and what does it reply? Give the code.", "has": ["apsw\\.ConstraintError", "_error|422"], "lacks": ["SELECT .*email.*\\n.*if .*:\\s*\\n.*_error"]}
{"id": "d-after-create", "mode": "answer", "prompt": "A Datastar command creates an article. The browser should then show the new article's page. What does the handler reply? Give the code.", "has": ["SSE\\(w\\)\\.navigate\\("], "lacks": ["w\\.redirect\\("]}
{"id": "d-plain-form", "mode": "answer", "prompt": "A plain <form method=\"post\"> without Datastar saves a setting. What does the handler reply after saving? Give the code.", "has": ["w\\.redirect\\(.*303"]}
{"id": "d-port", "mode": "answer", "prompt": "The hosting platform gives the port in $PORT and expects the app to listen on all interfaces. What is the start command?", "has": ["STARIO_HOST=0\\.0\\.0\\.0", "STARIO_PORT=\\$PORT"]}
{"id": "d-env-setting", "mode": "answer", "prompt": "The spec says the app reads the SQLite path from DATABASE_PATH, default data/app.sqlite3. Where and how do you add that? Give the code.", "has": ["(?i)already|database_path"], "lacks": ["os\\.environ"]}
{"id": "d-stop-server", "mode": "answer", "prompt": "In an earlier command you started the app with `uv run python -m app.main &` to try it. How do you stop it?", "has": ["lsof -ti (tcp)?:\\d+"], "lacks": ["pkill"]}
{"id": "d-own-tests", "mode": "answer", "prompt": "The task ships a Playwright acceptance suite run by `npm test`. Do you also write your own pytest tests for the new pages? Answer yes or no, then one sentence.", "has": ["(?i)^\\W*no\\b"]}
{"id": "d-imports", "mode": "answer", "prompt": "Write the import lines for SSE, at, data and read_signals.", "has": ["from stario\\.datastar import"], "lacks": ["from stario import [^\\n]*\\b(SSE|at|data|read_signals)\\b"]}
{"id": "d-json", "mode": "answer", "prompt": "A column holds a JSON list of tag strings. Write the line that turns the column value `raw` into a list[str].", "has": ["cast\\(list\\[str\\],\\s*loads\\(raw\\)\\)"], "lacks": ["import json", "json\\.loads"]}
{"id": "d-get-toggle", "mode": "answer", "prompt": "Can a link to GET /todos/{id}/toggle mark a todo done? Answer yes or no, then say what to use.", "has": ["(?i)^\\W*no\\b", "POST|at\\.post"]}
{"id": "d-sort-state", "mode": "answer", "prompt": "Where does the current sort order of a list live: a signal, a cookie, server memory, or the URL?", "has": ["(?i)URL|query"], "lacks": ["(?i)^\\W*(a )?signal"]}
{"id": "d-shared-markup", "mode": "answer", "prompt": "The articles page and the profile page both show the same article preview card. Where does the function that renders the card go?", "has": ["app/layout\\.py"]}
{"id": "d-classes", "mode": "answer", "prompt": "Write an h.Div with id \"card\", the class \"card\", and the class \"active\" when the variable active is true, containing the text \"Hi\".", "has": ["classes\\("], "lacks": ["\"class\":\\s*classes\\("]}
{"id": "d-attr-order", "mode": "answer", "prompt": "Write an h.Button with the text \"Save\" that posts to SAVE.href() on click.", "has": ["h\\.Button\\(\\s*(\\{[^}]*\\},\\s*)?data\\.on\\([^\\n]*\\),\\s*\"Save\"\\s*\\)"]}
{"id": "d-schema-change", "mode": "answer", "prompt": "The posts table holds rows. You need a new column `views INTEGER NOT NULL DEFAULT 0`. Where and how do you add it? Give the code.", "has": ["ALTER TABLE posts ADD COLUMN views", "schema"], "lacks": ["DROP TABLE"]}
{"id": "d-private-signal", "mode": "answer", "prompt": "The server sets an error message signal that the browser must never send back. What is it named and why?", "has": ["_error|\\b_\\w+"]}
{"id": "d-dialog", "mode": "answer", "prompt": "A <dialog> on a live page closes every time the stream repaints the page. What fixes it? Give the code.", "has": ["preserve_attr\\(\"open\"\\)"]}
{"id": "d-no-just", "mode": "answer", "prompt": "`just` is not installed. How do you run the app's check?", "has": ["uvx stario-create(@latest)? check"]}
{"id": "d-stream-row-gone", "mode": "answer", "prompt": "A live stream for /articles/{id}/live finds that its article was deleted. What does the stream do?", "has": ["(?i)return"], "lacks": ["navigate\\("]}
{"id": "d-generated-tests", "mode": "answer", "prompt": "tests/test_pages.py fails on your new page. Do you edit tests/test_pages.py or tests/_pagecheck.py? Answer yes or no, then what you do.", "has": ["(?i)^\\W*no\\b"]}
{"id": "d-see-page", "mode": "answer", "prompt": "You want to see the HTML that GET /todos returns, without starting a server. What command do you run?", "has": ["stario-create(@latest)? request GET /todos"], "lacks": ["curl"]}
{"id": "d-js-place", "mode": "answer", "prompt": "A data.on handler needs ten lines of JavaScript to draw on a canvas. Where does that JavaScript go and how does the attribute call it?", "skills": ["stario-js"], "has": ["static/js/\\w+\\.js", "app\\.\\w+"]}
{"id": "d-page-file", "mode": "answer", "prompt": "Name the files you touch to add a new page /rooms with a live list.", "has": ["app/urls\\.py", "app/pages/rooms\\.py", "app/main\\.py"], "lacks": ["add page"]}
{"id": "table-and-classes", "mode": "answer", "prompt": "Render a table with a header row and a body row whose <tr> gets the class `active` when `on` is true. Give the h.* code only.", "has": ["h\\.Thead\\(", "h\\.Tbody\\(", "classes\\("], "lacks": ["h\\.THead", "h\\.TBody", "\"class\":\\s*classes\\("]}
